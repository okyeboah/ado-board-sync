<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="AdoBoardSync.Desktop.App"
             Name="ADO Board Sync"
             RequestedThemeVariant="Default">

    <!-- Tokens load as a resource dictionary, styles load as a styles tree.
         The two cannot be merged: a Styles file cannot see Application.Resources
         through StaticResource, which is why everything in them binds Dynamic. -->
    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="/Styles/TextStyles.axaml" />
        <StyleInclude Source="/Styles/ControlStyles.axaml" />
    </Application.Styles>

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="/Styles/Theme.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
