# Credentials — never commit a PAT
.ado_pat
*.pat

# Python
__pycache__/
*.pyc
.venv/

# Python sdist/wheel output. Anchored: an unanchored `build/` would also match
# desktop/build/, which is committed source, not output.
/build/
/dist/
*.egg-info/

# .NET (desktop app)
bin/
obj/

# Publish and packaging output (ABSD-601/602). A self-contained build is ~110 MB
# per runtime identifier; these are release artifacts, not source.
desktop/artifacts/
*.user
TestResults/

# Real board profiles and scratch backlogs — these name a live organisation
desktop/local/
*.local.json

# IDE workspace state — per-developer, never shared
.idea/
.vs/
*.DotSettings.user

# Local presentation — not part of the package
/presentation.html

# Local secrets
.env
.env.local
.env.*.local

# Local AI tooling. The portable agent setup is local to each workstation, so
# the adapter stubs and harness state are never committed.
.claude/
.mcp.json
# Anchored: desktop/AGENTS.md is tracked project documentation, not an adapter.
/AGENTS.md
/CLAUDE.md

# Retired harness (ruflo, removed 2026-09-03). Ignoring these does not prevent a
# stray `ruflo init` from re-creating them — it only keeps them out of a commit.
# The prohibition itself lives in ~/.agent/protocols/harness-precedence.md
# (Rule 4); the repo-local account is in .agents/skills/ruflo/.
.claude-flow/
.swarm/
ruvector.db*

# Project-scoped agent skills are committed; everything else under .agents is local.
.agents/*
!.agents/skills/
!.agents/skills/**
uv.lock
.stele-context/
